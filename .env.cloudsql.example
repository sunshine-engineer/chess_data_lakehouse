CLOUDSQL_CONNECTION_NAME=your-project:your-region:your-instance
GCLOUD_CONFIG_DIR=/absolute/path/to/new-device/gcloud
LOCAL_UID=1000
LOCAL_GID=1000
SOURCE_DOCKER_NETWORK=chess-lakehouse_default
SOURCE_PGHOST=chess-lakehouse-postgres-1
SOURCE_DBNAME=chess
SOURCE_ADMIN_USER=chess
TARGET_DBNAME=chess
TARGET_LOGIN=dev
TARGET_ADMIN_USER=postgres
# Private files: source-password and postgres-password. dev-password is generated.
CLOUDSQL_PRIVATE_DIR=./data/secrets/cloudsql
CLOUDSQL_WORK_DIR=./data/transfers/cloudsql
