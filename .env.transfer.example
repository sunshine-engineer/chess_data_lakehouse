# Copy to .env.transfer; never commit real credentials. Plan is the default.
SOURCE_PGHOST=replace-source-host
SOURCE_PGPORT=5432
SOURCE_PGDATABASE=chess
SOURCE_PGUSER=chess
SOURCE_PGPASSWORD=replace-source-password
SOURCE_PGSSLMODE=verify-full
# Mount your CA files using an override; paths must exist inside the container.
SOURCE_PGSSLROOTCERT=/certificates/source-ca.crt
TARGET_PGHOST=replace-target-host
TARGET_PGPORT=5432
TARGET_PGDATABASE=chess
TARGET_PGUSER=chess
TARGET_PGPASSWORD=replace-target-password
TARGET_PGSSLMODE=verify-full
TARGET_PGSSLROOTCERT=/certificates/target-ca.crt
