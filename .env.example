# Local development only. Copy to .env and choose a password before starting.
POSTGRES_USER=chess
POSTGRES_DB=chess
POSTGRES_PASSWORD=replace-with-a-local-password
LOADER_PASSWORD=replace-with-a-separate-loader-password
READER_PASSWORD=replace-with-a-separate-reader-password
WEB_PORT=8080
STUDY_PASSWORD=replace-with-a-separate-personal-study-password
STUDY_API_TOKEN=replace-with-a-long-random-internal-service-token
# Personal libraries: 0 disables these quotas. Processing remains streamed/chunked.
STUDY_MAX_LIBRARY_GAMES=0
STUDY_MAX_STORAGE_BYTES=0
STUDY_BATCH_GAMES=100
STUDY_MIN_FREE_DISK_BYTES=268435456
STUDY_SECURE_COOKIES=0
# Deployment settings; container ports match Compose services and health checks.
CHESS_RUNTIME_CONFIG=config/runtime.toml
CHESS_WEB_THREADS=4
CHESS_STUDY_THREADS=4
STUDY_MAX_UPLOAD_BYTES=1099511627776
STUDY_PROXY_TIMEOUT_SECONDS=300
STUDY_WORKER_POLL_SECONDS=1
STUDY_SHUTDOWN_SECONDS=330
STUDY_REPERTOIRE_GAME_SECONDS=30
CHESS_ARCHIVE_POLL_SECONDS=3
CHESS_ARCHIVE_CHECK_SECONDS=3600
# Default preserves embedded Compose mode. compose.workers.yaml sets this to 0.
STUDY_WORKER=1
